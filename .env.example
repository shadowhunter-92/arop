# Copy to .env and fill in values before running docker-compose.prod.yml

# PostgreSQL password (used by both postgres and proxy services)
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32

# AROP master API key — used to authenticate proxy requests and access the dashboard
# Generate with: openssl rand -hex 32
AROP_MASTER_KEY=change-me-use-openssl-rand-hex-32

# LLM provider keys (add whichever you use)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Dashboard URL exposed to browsers (set to your public domain in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Privacy settings
HASH_PAYLOADS=true    # SHA-256 hashes stored; no plaintext in DB (recommended)
STORE_RAW=false       # Set true to store raw payloads (requires trust in your infra)
